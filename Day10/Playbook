- hosts: app_nodes
  tasks:
    - name: Install Java
      yum:
        name: java-11-amazon-corretto-devel
        state: present

    - name: Install Tomcat 9
      yum:
        name: tomcat
        state: present

    - name: Copy WAR file from Jenkins workspace
      copy:
        src: target/addressbook.war
        dest: /usr/share/tomcat/webapps/addressbook.war

    - name: Start Tomcat
      systemd:
        name: tomcat
        state: started
        enabled: yes
